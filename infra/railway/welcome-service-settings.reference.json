{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/railway/Dockerfile.welcome"
  },
  "deploy": {
    "startCommand": "node infra/railway/run-welcome-outbox.mjs",
    "cronSchedule": "*/5 * * * *",
    "restartPolicyType": "NEVER",
    "healthcheckPath": null,
    "numReplicas": 1
  }
}
