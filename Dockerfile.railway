# Multi-platform official Node image digest verified against Docker Hub.
# This reproducible artifact retains the guarded preparation runtime.
FROM node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS build
WORKDIR /app
COPY . .
# Missing user-owned lock/catalog source fails before any dependency install.
RUN node infra/railway/preflight.mjs
RUN npm ci --ignore-scripts --no-audit --no-fund
RUN node node_modules/vite/bin/vite.js build --config vite.railway.config.ts

FROM node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS preparation
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/dist ./dist
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/infra/railway/preparation-server.mjs ./infra/railway/preparation-server.mjs
COPY --from=build /app/infra/railway/allowance-worker.mjs ./infra/railway/allowance-worker.mjs
COPY --from=build /app/infra/railway/reservation-expiry.mjs ./infra/railway/reservation-expiry.mjs
COPY --from=build /app/infra/railway/runtime/aaro-usage-ingress.mjs ./infra/railway/runtime/aaro-usage-ingress.mjs
COPY --from=build /app/infra/railway/runtime/aaro-usage-bridge.mjs ./infra/railway/runtime/aaro-usage-bridge.mjs
COPY --from=build /app/infra/railway/runtime/stripe-webhook-ingress.mjs ./infra/railway/runtime/stripe-webhook-ingress.mjs
COPY --from=build /app/infra/railway/runtime/stripe-projection-rpc.mjs ./infra/railway/runtime/stripe-projection-rpc.mjs
COPY --from=build /app/infra/railway/runtime/stripe-financial-projection.mjs ./infra/railway/runtime/stripe-financial-projection.mjs
COPY --from=build /app/infra/railway/runtime/supabase-gateway-rpc.mjs ./infra/railway/runtime/supabase-gateway-rpc.mjs
COPY --from=build /app/infra/railway/runtime/subrouter-native-auth.mjs ./infra/railway/runtime/subrouter-native-auth.mjs
COPY --from=build /app/infra/railway/runtime/subrouter-native-customer.mjs ./infra/railway/runtime/subrouter-native-customer.mjs
COPY --from=build /app/infra/railway/runtime/native-session-store.mjs ./infra/railway/runtime/native-session-store.mjs
COPY --from=build /app/infra/railway/runtime/native-auth-http.mjs ./infra/railway/runtime/native-auth-http.mjs
COPY --from=build /app/infra/railway/runtime/customer-key-rpc.mjs ./infra/railway/runtime/customer-key-rpc.mjs
COPY --from=build /app/infra/railway/runtime ./infra/railway/runtime
COPY --from=build /app/data/selected-supplier-models.json ./data/selected-supplier-models.json
USER node
CMD ["node", "infra/railway/preparation-server.mjs"]
